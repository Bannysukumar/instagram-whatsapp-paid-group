# Copy to .env and replace every placeholder before use.
# Never commit .env or the WhatsApp browser profile.

PORT=4000
# Public site address. On aaPanel use https://your-domain. Local development stays http://localhost:5173.
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development
# Set true on aaPanel so registration limits use each visitor's address behind Nginx.
TRUST_PROXY=false
# Linux server without a desktop: true. Scan the QR from the admin screenshot.
WHATSAPP_HEADLESS=false

# Administrator dashboard login. Use a long unique password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-password
TOKEN_SECRET=replace-with-a-long-random-string
TOKEN_TTL_HOURS=12

# file (default, stored in backend/data) or mongo
DATABASE=file
MONGODB_URI=mongodb://127.0.0.1:27017/whatsapp_group

# Payments stay off until you set this to true and fill in Razorpay test keys.
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
# Amount in minor units. 49900 paise = INR 499.00
PAYMENT_AMOUNT=49900
PAYMENT_CURRENCY=INR

# Seed values for the first local run. Later edits from the dashboard are saved on disk.
GROUP_INVITE_LINK=https://chat.whatsapp.com/REPLACE_WITH_YOUR_CODE
GROUP_NAME=
# invite: show the link after eligibility. approval: same link, status pending_admission.
ADMISSION_MODE=invite

# Direct add is best-effort and off by default. WhatsApp Web usually cannot
# select unsaved numbers. Leave this false unless you have confirmed the
# add-participant control can see the number.
DIRECT_ADD_ENABLED=false
AUTOMATION_ENABLED=true
RATE_LIMIT_ENABLED=true
